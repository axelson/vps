#!/usr/bin/env bash
# delete <name> — removes a bundle.
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# -eq 1 ]] || die "usage: delete <name>"
valid_name "$1" || die "invalid name '$1'"

split_response "$(api DELETE "/bundles/$1")"
case $STATUS in
  204) echo "deleted $1" ;;
  404) die "no bundle named $1" ;;
  *) die "delete failed ($STATUS): $BODY" ;;
esac
